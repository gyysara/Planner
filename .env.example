# Скопируйте в .env НА СЕРВЕРЕ и заполните. Файл .env не коммитится.

# Домен планнера (A-запись должна указывать на статический IP Lightsail)
DOMAIN=planner.example.com

# Код приглашения для регистрации. Без него зарегистрироваться нельзя.
# Придумайте длинный (16+ символов) и передавайте только своей команде.
INVITE_CODE=

# Ключ шифрования для ключей Telegram-ботов, которые пользователи вводят в Настройках.
# Сгенерируйте один раз: openssl rand -base64 32
# Не меняйте после запуска — иначе сохранённые ключи ботов перестанут расшифровываться.
SECRET_KEY=

# Часовой пояс команды: дедлайны, напоминания и недели отчёта
TZ_NAME=Europe/Minsk
